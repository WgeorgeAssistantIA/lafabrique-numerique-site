# Formulaire de contact (app/api/contact/route.ts)
# Clé API Resend (sending_access suffit) — https://resend.com/api-keys
RESEND_API_KEY=

# Destinataire des demandes de devis (défaut : lafabriknumerique@outlook.com)
# CONTACT_TO=

# Expéditeur — le domaine doit être vérifié dans Resend
# (défaut : "La Fabrik Numérique <contact@lafabriknumerique.fr>")
# CONTACT_FROM=

# Codes de récompense de l'atelier secret (app/api/secret-codes/route.ts).
# Jamais dans le code : le dépôt est public. Révélés uniquement aux joueurs
# qui envoient les bonnes réponses du jeu de piste. Un code vide = palier absent.
# SECRET_CODE_FR_100=
# SECRET_CODE_FR_50=
# SECRET_CODE_EN_100=
# SECRET_CODE_EN_50=

# Optionnel : affiche le nombre de codes restants (lecture seule suffit).
# LEMONSQUEEZY_API_KEY=

# Upstash (Vercel KV) : tableau des trouveurs + limitation de débit des API.
# Sans ces variables, la limitation est désactivée (développement local).
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
